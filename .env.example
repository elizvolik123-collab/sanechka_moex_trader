# Пример настроек. Для первого локального запуска: node scripts/setup-local.mjs
# Для сервера скопируйте этот файл в .env и заполните параметры ниже.
# Реальные значения остаются только в вашем .env; не отправляйте его и не добавляйте в Git.

# Локальная база: DATABASE_URL и DEV_DB_PASSWORD должны содержать один и тот же пароль.
# Docker Compose задаёт DATABASE_URL автоматически через POSTGRES_PASSWORD.
DATABASE_URL=
# DEV_DB_PASSWORD=
# DEV_DB_PORT=5433
# DEV_DB_NAME=moex_trader

# Для сервера: домен без схемы; пароль БД удобнее создать из букв и цифр.
# DOMAIN=
# POSTGRES_PASSWORD=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Секрет сессий: минимум 32 символа.
BETTER_AUTH_SECRET=
# Ключ шифрования брокерских токенов: версия:base64(32 случайных байта).
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Необязательно: SMTP для восстановления пароля. Укажите URL своего SMTP вручную.
SMTP_URL=
# MAIL_FROM=
# Только локально, вместо SMTP: сохранять тестовые письма в .data/mail.
# MAIL_LOCAL_OUTBOX=true

# Необязательно: публичные источники. Ключи MOEX ISS и Telegram не нужны.
# MOEX_ISS_URL=https://iss.moex.com/iss
# NEWS_CHANNEL=markettwits
# TELEGRAM_PREVIEW_URL=https://t.me/s
# Для своего сетевого прокси (Node 24):
# HTTPS_PROXY=
# NODE_USE_ENV_PROXY=1

# Токен брокера вводится в приложении: Кабинет → Брокеры → API-токен.
# Для тестирования с локальным мок-сервером задайте только вымышленный токен.
# MOCK_TINVEST_TOKEN=
# TINVEST_API_URL=http://127.0.0.1:4010/rest
# TINVEST_LOGO_CDN_URL=http://127.0.0.1:4010/logos

LOG_LEVEL=info
